{
    "name": "ndtc-campaign-tracker",
    "version": "1.0.0",
    "description": "A tiny tracking app for political campaigns",
    "private": true,
    "workspaces": [
        "backend",
        "frontend"
    ],
    "scripts": {
        "dev": "concurrently -k \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
        "dev:backend": "npm run dev --workspace=backend",
        "dev:frontend": "npm run dev --workspace=frontend",
        "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
        "build:backend": "npm run build --workspace=backend",
        "build:frontend": "npm run build --workspace=frontend",
        "start": "npm start --workspace=backend"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/supertest": "^6.0.3",
        "concurrently": "^8.2.2",
        "jest": "^30.0.4",
        "supertest": "^7.1.3",
        "ts-jest": "^29.4.0"
    },
    "dependencies": {
        "autoprefixer": "^10.4.21",
        "tailwindcss": "^4.1.11"
    },
    "backend": {
        "scripts": {
            "dev": "nodemon src/server.ts",
            "build": "tsc",
            "start": "node dist/server.js",
            "start:prod": "NODE_ENV=production node dist/server.js",
            "test": "NODE_ENV=test jest",
            "test:watch": "NODE_ENV=test jest --watch",
            "test:coverage": "NODE_ENV=test jest --coverage",
            "db:backup": "ts-node scripts/backup-db.ts",
            "db:info": "ts-node scripts/db-info.ts"
        }
    }
}
